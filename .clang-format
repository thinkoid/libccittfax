---
Language:        C
BasedOnStyle:    LLVM

# --- Indentation ---
IndentWidth:     8
UseTab:          Never
TabWidth:        8
ContinuationIndentWidth: 8

# --- Braces ---
BreakBeforeBraces: Attach
AllowShortBlocksOnASingleLine: false
AllowShortFunctionsOnASingleLine: InlineOnly

# --- Spaces ---
SpaceBeforeParens: Never         # <-- important: if(x), f(x)
SpaceAfterCStyleCast: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInCStyleCastParentheses: false

# --- Preprocessor ---
IndentPPDirectives: AfterHash
# SpaceBeforeCppDirectiveHash: false

# --- Includes ---
IncludeBlocks: Preserve
SortIncludes: false              # preserve your careful include order

# --- Pointers ---
PointerAlignment: Left
DerivePointerAlignment: false

# --- Macros ---
DisableFormat: true              # let YOU control the big blocks, like your keymaps

# --- Alignment ---
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments: false
AlignAfterOpenBracket: Align

# --- Wrapping ---
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false
BreakBeforeBinaryOperators: None
BreakConstructorInitializers: BeforeColon
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyReturnTypeOnItsOwnLine: 60
PenaltyBreakAssignment: 25

# --- Comments ---
CommentPragmas: '^ IWYU pragma:'  # leave this default

...
